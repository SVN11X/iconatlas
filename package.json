{
  "name": "iconatlas",
  "private": true,
  "version": "1.0.0",
  "description": "IconAtlas — catálogo universal de iconos, estático y publicable en GitHub Pages.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "catalog": "node scripts/build-catalog/index.mjs",
    "catalog:validate": "node scripts/validate-icons/index.mjs",
    "catalog:check-sources": "node scripts/check-sources/index.mjs",
    "github:health": "node scripts/github-health.mjs",
    "github:discover": "node scripts/github-discover.mjs",
    "github:import": "node scripts/github-import.mjs",
    "import-icons": "node scripts/import-icons/index.mjs",
    "predev": "node scripts/build-catalog/index.mjs --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/build-catalog/index.mjs && node scripts/validate-icons/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "tsc -b --noEmit",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "node --test scripts/lib/svg-safety.test.mjs scripts/lib/github-repos.test.mjs scripts/import-icons/import.test.mjs scripts/github-index.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "github:index": "node scripts/github-index.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.21",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "lucide-react": "^1.59.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/codicon": "^1.2.74",
    "@iconify-json/devicon": "^1.2.71",
    "@iconify-json/fluent": "^1.2.60",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.16",
    "@iconify-json/lucide": "^1.2.145",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/tabler": "^1.2.42",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@ui5/webcomponents-icons": "^2.27.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "simple-icons": "^16.35.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
